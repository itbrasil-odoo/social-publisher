<?xml version="1.0" encoding="utf-8"?>
<odoo>
    <record id="res_groups_privilege_social_publisher" model="res.groups.privilege">
        <field name="name">Social Publisher</field>
        <field name="category_id" ref="base.module_category_marketing"/>
    </record>

    <!-- Writes drafts and reads everything; cannot approve or publish.
         This is the right group for an AI agent connected to Odoo. -->
    <record id="group_social_publisher_user" model="res.groups">
        <field name="name">Writer</field>
        <field name="sequence">10</field>
        <field name="privilege_id" ref="res_groups_privilege_social_publisher"/>
        <field name="implied_ids" eval="[(4, ref('base.group_user'))]"/>
    </record>

    <record id="group_social_publisher_manager" model="res.groups">
        <field name="name">Manager</field>
        <field name="sequence">20</field>
        <field name="comment">Approves and publishes posts, manages accounts.</field>
        <field name="privilege_id" ref="res_groups_privilege_social_publisher"/>
        <field name="implied_ids" eval="[(4, ref('group_social_publisher_user'))]"/>
        <field name="user_ids" eval="[(4, ref('base.user_root')), (4, ref('base.user_admin'))]"/>
    </record>

    <record id="social_publisher_account_rule_company" model="ir.rule">
        <field name="name">Social Publisher account: multi-company</field>
        <field name="model_id" ref="model_social_publisher_account"/>
        <field name="domain_force">['|', ('company_id', '=', False), ('company_id', 'in', company_ids)]</field>
    </record>

    <record id="social_publisher_post_rule_company" model="ir.rule">
        <field name="name">Social Publisher post: multi-company</field>
        <field name="model_id" ref="model_social_publisher_post"/>
        <field name="domain_force">['|', ('company_id', '=', False), ('company_id', 'in', company_ids)]</field>
    </record>

    <record id="social_publisher_metric_rule_company" model="ir.rule">
        <field name="name">Social Publisher metric: multi-company</field>
        <field name="model_id" ref="model_social_publisher_metric"/>
        <field name="domain_force">['|', ('company_id', '=', False), ('company_id', 'in', company_ids)]</field>
    </record>
</odoo>
