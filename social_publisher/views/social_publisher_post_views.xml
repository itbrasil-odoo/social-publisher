<?xml version="1.0" encoding="utf-8"?>
<odoo>
    <record id="social_publisher_post_view_form" model="ir.ui.view">
        <field name="name">social.publisher.post.form</field>
        <field name="model">social.publisher.post</field>
        <field name="arch" type="xml">
            <form string="Post">
                <header>
                    <button name="action_approve" type="object" string="Approve"
                            class="btn-primary" invisible="state not in ('draft', 'failed')"
                            groups="social_publisher.group_social_publisher_manager"/>
                    <button name="action_publish_now" type="object" string="Publish Now"
                            class="btn-primary" invisible="state != 'approved'"
                            groups="social_publisher.group_social_publisher_manager"
                            confirm="Publish this post now?"/>
                    <button name="action_refresh_metrics" type="object" string="Refresh Metrics"
                            invisible="state != 'published'"/>
                    <button name="action_reset_draft" type="object" string="Back to Draft"
                            invisible="state not in ('approved', 'failed')"/>
                    <field name="state" widget="statusbar"
                           statusbar_visible="draft,approved,published"/>
                </header>
                <sheet>
                    <div class="oe_button_box" name="button_box">
                        <button name="action_open_external" type="object" class="oe_stat_button"
                                icon="fa-external-link" string="View Post"
                                invisible="not external_url"/>
                    </div>
                    <div class="alert alert-danger" role="alert" invisible="state != 'failed'">
                        <field name="failure_reason"/>
                    </div>
                    <field name="image" widget="image" readonly="state in ('published', 'publishing')" class="oe_avatar" options="{'size': [180, 180]}"/>
                    <div class="oe_title">
                        <h1><field name="name" readonly="1"/></h1>
                    </div>
                    <group>
                        <group>
                            <field name="account_id" options="{'no_create': True}" readonly="state in ('published', 'publishing')"/>
                            <field name="publish_at" readonly="state in ('published', 'publishing')"/>
                            <field name="published_at" invisible="not published_at"/>
                            <field name="company_id" groups="base.group_multi_company" readonly="1"
                                   invisible="not company_id"/>
                            <field name="tag_ids" widget="many2many_tags" options="{'color_field': 'color'}"/>
                        </group>
                        <group>
                            <field name="lang"/>
                            <field name="reference"/>
                            <field name="locked_first_line" readonly="state in ('published', 'publishing')"/>
                            <field name="image_alt" invisible="not image" readonly="state in ('published', 'publishing')"/>
                        </group>
                    </group>
                    <notebook>
                        <page string="Text" name="text">
                            <field name="body" nolabel="1" readonly="state in ('published', 'publishing')" placeholder="Write the post exactly as it should appear..."/>
                            <div class="text-muted small">
                                <field name="char_count" class="oe_inline"/>
                                <span invisible="not max_length"> / <field name="max_length" class="oe_inline"/></span>
                                characters
                            </div>
                        </page>
                        <page string="Metrics" name="metrics" invisible="state != 'published'">
                            <group>
                                <group>
                                    <field name="impressions"/>
                                    <field name="members_reached"/>
                                    <field name="engagement_rate" string="Engagement (%)"/>
                                    <field name="metrics_updated_at"/>
                                </group>
                                <group>
                                    <field name="reactions"/>
                                    <field name="comments"/>
                                    <field name="reshares"/>
                                    <field name="saves"/>
                                    <field name="sends"/>
                                    <field name="link_clicks"/>
                                    <field name="profile_views"/>
                                    <field name="followers_gained"/>
                                </group>
                            </group>
                            <field name="metric_ids" readonly="1">
                                <list>
                                    <field name="date"/>
                                    <field name="impressions"/>
                                    <field name="members_reached"/>
                                    <field name="reactions"/>
                                    <field name="comments"/>
                                    <field name="reshares"/>
                                </list>
                            </field>
                        </page>
                        <page string="Notes" name="notes">
                            <field name="note" nolabel="1"/>
                            <group invisible="not external_id">
                                <field name="external_id"/>
                                <field name="external_url" widget="url"/>
                            </group>
                        </page>
                    </notebook>
                </sheet>
                <chatter/>
            </form>
        </field>
    </record>

    <record id="social_publisher_post_view_list" model="ir.ui.view">
        <field name="name">social.publisher.post.list</field>
        <field name="model">social.publisher.post</field>
        <field name="arch" type="xml">
            <list string="Posts" decoration-muted="state == 'draft'" decoration-danger="state == 'failed'">
                <field name="calendar_date" string="Date"/>
                <field name="name"/>
                <field name="reference" optional="show"/>
                <field name="account_id" optional="show"/>
                <field name="company_id" groups="base.group_multi_company" optional="hide"/>
                <field name="tag_ids" widget="many2many_tags" options="{'color_field': 'color'}" optional="show"/>
                <field name="state" widget="badge"
                       decoration-info="state == 'approved'"
                       decoration-success="state == 'published'"
                       decoration-danger="state == 'failed'"/>
                <field name="impressions" optional="show" sum="Total"/>
                <field name="members_reached" optional="show" sum="Total"/>
                <field name="reactions" optional="show" sum="Total"/>
                <field name="comments" optional="show" sum="Total"/>
                <field name="engagement_rate" optional="hide" string="Engagement (%)"/>
                <field name="activity_ids" widget="list_activity" optional="show"/>
            </list>
        </field>
    </record>

    <record id="social_publisher_post_view_kanban" model="ir.ui.view">
        <field name="name">social.publisher.post.kanban</field>
        <field name="model">social.publisher.post</field>
        <field name="arch" type="xml">
            <kanban default_group_by="state" quick_create="false" records_draggable="false"
                    group_create="false" group_delete="false" group_edit="false">
                <field name="state"/>
                <field name="image"/>
                <templates>
                    <t t-name="card" class="flex-row">
                        <aside t-if="record.image.raw_value" class="me-2">
                            <field name="image" widget="image" options="{'size': [64, 64], 'img_class': 'rounded'}"
                                   alt="Artwork"/>
                        </aside>
                        <main class="flex-grow-1">
                            <field name="name" class="fw-bold"/>
                            <field name="reference" class="text-muted small"/>
                            <field name="tag_ids" widget="many2many_tags" options="{'color_field': 'color'}"/>
                            <footer class="pt-1">
                                <div class="d-flex gap-1 text-muted small">
                                    <i class="fa fa-calendar" title="Date"/>
                                    <field name="calendar_date" widget="datetime"/>
                                </div>
                                <div class="ms-auto d-flex align-items-center gap-2">
                                    <span class="text-muted small text-nowrap" t-if="record.state.raw_value == 'published'">
                                        <i class="fa fa-eye" title="Impressions"/> <field name="impressions"/>
                                        <i class="fa fa-thumbs-up ms-2" title="Reactions"/> <field name="reactions"/>
                                    </span>
                                    <field name="activity_ids" widget="kanban_activity"/>
                                </div>
                            </footer>
                        </main>
                    </t>
                </templates>
            </kanban>
        </field>
    </record>

    <record id="social_publisher_post_view_calendar" model="ir.ui.view">
        <field name="name">social.publisher.post.calendar</field>
        <field name="model">social.publisher.post</field>
        <field name="arch" type="xml">
            <calendar string="Posts" date_start="calendar_date" color="state_color" mode="month"
                      event_open_popup="true" quick_create="0" scales="day,week,month,year">
                <field name="state" filters="1"/>
                <field name="account_id" filters="1"/>
                <field name="tag_ids" widget="many2many_tags" options="{'color_field': 'color'}" filters="1"
                       invisible="not tag_ids"/>
                <field name="reference" invisible="not reference"/>
                <field name="impressions" invisible="state != 'published'"/>
                <field name="reactions" invisible="state != 'published'"/>
            </calendar>
        </field>
    </record>

    <record id="social_publisher_post_view_pivot" model="ir.ui.view">
        <field name="name">social.publisher.post.pivot</field>
        <field name="model">social.publisher.post</field>
        <field name="arch" type="xml">
            <pivot string="Posts">
                <field name="published_at" interval="week" type="row"/>
                <field name="tag_ids" type="col"/>
                <field name="impressions" type="measure"/>
                <field name="reactions" type="measure"/>
                <field name="comments" type="measure"/>
            </pivot>
        </field>
    </record>

    <record id="social_publisher_post_view_graph" model="ir.ui.view">
        <field name="name">social.publisher.post.graph</field>
        <field name="model">social.publisher.post</field>
        <field name="arch" type="xml">
            <graph string="Posts" type="bar">
                <field name="published_at" interval="week"/>
                <field name="impressions" type="measure"/>
            </graph>
        </field>
    </record>

    <record id="social_publisher_post_view_search" model="ir.ui.view">
        <field name="name">social.publisher.post.search</field>
        <field name="model">social.publisher.post</field>
        <field name="arch" type="xml">
            <search string="Posts">
                <field name="body" string="Text"/>
                <field name="account_id"/>
                <field name="tag_ids"/>
                <field name="reference"/>
                <filter name="filter_draft" string="Drafts" domain="[('state', '=', 'draft')]"/>
                <filter name="filter_approved" string="Approved" domain="[('state', '=', 'approved')]"/>
                <filter name="filter_published" string="Published" domain="[('state', '=', 'published')]"/>
                <filter name="filter_failed" string="Failed" domain="[('state', '=', 'failed')]"/>
                <separator/>
                <filter name="filter_scheduled" string="Scheduled"
                        domain="[('publish_at', '!=', False), ('state', '=', 'approved')]"/>
                <filter name="filter_next_7_days" string="Next 7 Days"
                        domain="[('publish_at', '>=', context_today().strftime('%Y-%m-%d')),
                                 ('publish_at', '&lt;', (context_today() + relativedelta(days=7)).strftime('%Y-%m-%d')),
                                 ('state', 'in', ('draft', 'approved'))]"/>
                <filter name="filter_unscheduled" string="Not Scheduled"
                        domain="[('publish_at', '=', False), ('state', 'in', ('draft', 'approved'))]"/>
                <separator/>
                <filter name="filter_kit" string="Kit Posts" domain="[('reference', 'ilike', 'kit')]"/>
                <filter name="filter_own" string="Own Posts"
                        domain="['|', ('reference', '=', False), ('reference', 'not ilike', 'kit')]"/>
                <filter name="filter_no_tag" string="Without Tags" domain="[('tag_ids', '=', False)]"/>
                <separator/>
                <filter name="filter_my_activities" string="My Activities"
                        domain="[('activity_user_id', '=', uid)]"/>
                <separator/>
                <filter name="filter_publish_at" string="Scheduled For" date="publish_at"/>
                <filter name="filter_published_at" string="Published On" date="published_at"/>
                <group>
                    <filter name="group_state" string="Status" context="{'group_by': 'state'}"/>
                    <filter name="group_tag" string="Tag" context="{'group_by': 'tag_ids'}"/>
                    <filter name="group_account" string="Account" context="{'group_by': 'account_id'}"/>
                    <filter name="group_company" string="Company" context="{'group_by': 'company_id'}"
                            groups="base.group_multi_company"/>
                    <filter name="group_scheduled" string="Scheduled Week"
                            context="{'group_by': 'publish_at:week'}"/>
                    <filter name="group_published" string="Publication Week"
                            context="{'group_by': 'published_at:week'}"/>
                </group>
                <searchpanel>
                    <field name="tag_ids" string="Tags" select="multi" icon="fa-tags" enable_counters="1"/>
                    <field name="account_id" string="Accounts" select="multi" icon="fa-user" enable_counters="1"/>
                </searchpanel>
            </search>
        </field>
    </record>

    <record id="social_publisher_post_action" model="ir.actions.act_window">
        <field name="name">Posts</field>
        <field name="res_model">social.publisher.post</field>
        <field name="view_mode">calendar,kanban,list,form,pivot,graph</field>
        <field name="help" type="html">
            <p class="o_view_nocontent_smiling_face">Write your first post</p>
            <p>Drafts are approved by a manager and published automatically at the scheduled time.</p>
        </field>
    </record>
</odoo>
