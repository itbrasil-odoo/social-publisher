<?xml version="1.0" encoding="utf-8" ?>
<odoo noupdate="1">
    <record id="ir_cron_publish_due" model="ir.cron">
        <field name="name">Social Publisher: Publish Scheduled Posts</field>
        <field name="model_id" ref="model_social_publisher_post" />
        <field name="state">code</field>
        <field name="code">model._cron_publish_due()</field>
        <field name="user_id" ref="base.user_root" />
        <field name="interval_number">5</field>
        <field name="interval_type">minutes</field>
    </record>

    <record id="ir_cron_sync_metrics" model="ir.cron">
        <field name="name">Social Publisher: Sync Metrics</field>
        <field name="model_id" ref="model_social_publisher_account" />
        <field name="state">code</field>
        <field name="code">model._cron_sync_metrics()</field>
        <field name="user_id" ref="base.user_root" />
        <field name="interval_number">1</field>
        <field name="interval_type">days</field>
        <field
            name="nextcall"
            eval="(DateTime.now() + timedelta(days=1)).strftime('%Y-%m-%d 09:00:00')"
        />
    </record>

    <record id="ir_cron_warn_expiring_access" model="ir.cron">
        <field name="name">Social Publisher: Warn About Expiring Access</field>
        <field name="model_id" ref="model_social_publisher_account" />
        <field name="state">code</field>
        <field name="code">model._cron_warn_expiring_access()</field>
        <field name="user_id" ref="base.user_root" />
        <field name="interval_number">1</field>
        <field name="interval_type">days</field>
    </record>
</odoo>
